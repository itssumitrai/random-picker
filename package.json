		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
